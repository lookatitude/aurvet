# testdata/roots/stock/usr/share/libalpm/hooks/50-foo.hook
#
# Package-owned system hook (listed in foo-bin's %FILES%), modelled on the shape
# of Arch's own hooks in /usr/share/libalpm/hooks: a [Trigger] naming packaged
# paths and an [Action] whose Exec regenerates a cache from them.
#
# Its Exec is what internal/check/exempt.go derives an exemption from:
# /var/cache/foo/index is regenerated by pacman, so it must not be reported as
# modified. /usr/bin/foo -- the command -- must NEVER become exempt.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/share/foo/*

[Action]
Description = Updating the foo index...
When = PostTransaction
Exec = /usr/bin/foo --rebuild-index /var/cache/foo/index
