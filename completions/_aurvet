#compdef aurvet
#
# zsh completion for aurvet
#
# The subcommand list below is asserted against cmd/aurvet's dispatch switch by
# completions/completions_test.go. A new subcommand that is not added here fails
# that test by name.

# Installed package names for -pkg, from the local database directory. No network
# and no `pacman` execution: a completion reads, like the rest of the tool (INV-2).
_aurvet_packages() {
	local -a pkgs
	local d
	for d in /var/lib/pacman/local/*(/N); do
		pkgs+=("${${d:t}%-*-*}")
	done
	_describe -t packages 'installed package' pkgs
}

_aurvet() {
	local -a commands
	# AURVET_COMMANDS_BEGIN
	commands=(
		'scan:sweep the system and report provenance findings'
		'diff:classify drift against the signed baseline (= baseline diff)'
		'baseline:the signed baseline and its trust chain'
		'triage:ack, snooze or note a finding -- local, unsigned, expiring'
		'adjudicate:record, list or revoke a signed judgement about a finding'
		'bundle:emit a redacted fixture root reproducing one finding'
		'update:fetch and verify the indicator bundle (never automatic)'
		'review:analyse one recipe; never builds it'
		'install:review the dependency closure, prompt, snapshot, hand over'
		'snapshot:capture provenance for one pkgbase'
		'explain:explain one finding by fingerprint'
		'doctor:print the resolved configuration and its sources'
		'version:print build identity'
	)
	# AURVET_COMMANDS_END

	local -a flags
	# AURVET_FLAGS_BEGIN
	flags=(
		'-json[emit machine-readable JSON instead of text]'
		'-no-network[skip every outbound request; network checks become coverage gaps]'
		'-since-last[scan: show only findings new since the previous scan]'
		'-since[diff: measure drift from this chain entry -- a seq, hash prefix, or head~N]:entry:'
		'-show-recipe[review/install: print the recipe text in full]'
		'-offline-root[examine a mounted filesystem instead of the running system]:root:_files -/'
		'-min-severity[reporting floor]:severity:(info suspicious critical)'
		'-key[baseline: an OpenSSH ed25519 private key file to sign with]:key:_files'
		'-signer[baseline: fingerprint of an ssh-agent key to sign with]:fingerprint:'
		'-remote[baseline pushed: the remote the chain was pushed to]:remote:'
		'-protected-remote[baseline pushed: assert the remote denies force-push]'
		'-tier[verification tier: how much of each file is examined]:tier:(meta triage full paranoid)'
		'-allow-degraded[scan: proceed unprivileged; the report is stamped DEGRADED and cannot exit 0]'
		\*'-pkg[scan: analyse only this package (repeatable)]:package:_aurvet_packages'
		'-reason[adjudicate: why this finding is acceptable -- mandatory and recorded]:reason:'
		'-scope[adjudicate: blast radius of the judgement]:scope:(pin subject rule)'
		'-expiry-days[adjudicate: days the judgement lasts (default 180, max 365)]:days:'
		'-force-rule-scope[adjudicate: the explicit force -scope rule requires]'
		'-bundle-url[update: the indicator bundle origin to fetch from]:url:'
		'-check[update: report what an update would do; writes no cache and no floor]'
		'-version[print build identity, root key fingerprints, delegation expiry and cached bundle version]'
	)
	# AURVET_FLAGS_END

	_arguments -C \
		$flags \
		'1: :->command' \
		'*:: :->argument'

	case $state in
	command)
		_describe -t commands 'aurvet command' commands
		;;
	argument)
		case $words[1] in
		review)
			# a recipe directory or a pkgbase; only the directory is completable
			_files -/
			;;
		baseline)
			_values 'baseline subcommand' init append status show verify pushed diff
			;;
		adjudicate)
			# list and revoke; the third form takes a finding fingerprint, which
			# nothing local can enumerate without running a scan.
			_values 'adjudicate subcommand' list revoke
			;;
		triage)
			# the three weights of §12's middle layer, plus list and drop.
			_values 'triage verb' ack snooze note list drop
			;;
		bundle)
			# a finding fingerprint, then the destination directory.
			_files -/
			;;
		update)
			_message 'update takes no arguments (--check is a flag)'
			;;
		diff)
			_message 'diff takes no arguments; it is `aurvet baseline diff`'
			;;
		*)
			# install/snapshot/explain take a pkgbase or a fingerprint. A
			# completion must not make a network request the user did not ask for.
			_message 'pkgbase or fingerprint'
			;;
		esac
		;;
	esac
}

_aurvet "$@"
